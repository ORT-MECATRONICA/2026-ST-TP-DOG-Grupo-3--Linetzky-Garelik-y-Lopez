#include <U8g2lib.h>

// OLED SH1106 128x64 por I2C
U8G2_SH1106_128X64_NONAME_F_HW_I2C u8g2(
  U8G2_R0,
  /* reset=*/ U8X8_PIN_NONE
);

void setup() {
  Serial.begin(9600);

  // Iniciar pantalla
  u8g2.begin();

  // Limpiar buffer
  u8g2.clearBuffer();

  // Escribir texto
  u8g2.setFont(u8g2_font_ncenB08_tr);
  u8g2.drawStr(0, 20, "HOLA!");

  u8g2.setFont(u8g2_font_ncenB10_tr);
  u8g2.drawStr(0, 45, "DISPLAY OK");

  // Mostrar en pantalla
  u8g2.sendBuffer();
}

void loop() {
}

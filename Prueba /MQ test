const int MQ_PIN = 34;

void setup() {
  Serial.begin(115200);

  analogReadResolution(12); // 0 a 4095
  pinMode(MQ_PIN, INPUT);

  Serial.println("Prueba del sensor MQ");
  Serial.println("Esperando...");
}

void loop() {
  int valor = analogRead(MQ_PIN);

  Serial.print("Valor del sensor: ");
  Serial.println(valor);

  delay(500);
}

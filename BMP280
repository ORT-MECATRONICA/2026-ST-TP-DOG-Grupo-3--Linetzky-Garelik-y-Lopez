#include <Wire.h>
#include <Adafruit_BMP280.h>


Adafruit_BMP280 bmp;


void setup() {
  Serial.begin(115200);
  delay(1000);


  Serial.println("Iniciando BMP280...");


  Wire.begin(21, 22);


  if (!bmp.begin(0x76)) {
    Serial.println("ERROR: No se encontro el BMP280");
    while (1) {
      delay(1000);
    }
  }


  Serial.println("BMP280 encontrado!");
}


void loop() {
  Serial.print("Temperatura: ");
  Serial.print(bmp.readTemperature());
  Serial.println(" °C");


  Serial.print("Presion: ");
  Serial.print(bmp.readPressure() / 100.0);
  Serial.println(" hPa");


  delay(2000);
}
